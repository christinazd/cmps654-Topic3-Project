{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DenyIfNoMFA",
            "Effect": "Deny",
            "NotAction": "iam:*",
            "Resource": "*",
            "Condition": {
                "BoolIfExists": {
                    "aws:MultiFactorAuthPresent": "false"
                }
            }
        },
        {
            "Sid": "DenyIfWrongLocation",
            "Effect": "Deny",
            "Action": "*",
            "Resource": "*",
            "Condition": {
                "NotIpAddress": {
                    "aws:SourceIp": [
                        "185.94.121.123/32"
                    ]
                }
            }
        }
    ]
}